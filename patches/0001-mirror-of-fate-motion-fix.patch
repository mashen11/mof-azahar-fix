+namespace MoFTrace {
+
+struct State {
+    int enabled = -1;
+    std::FILE* f = nullptr;
+    u64 frame = 0;
+    u64 draw_idx = 0;
+    u64 ucount = 0;
+    u64 ufirst = 0;
+    u64 ulast = 0;
+    u32 uxor = 0;
+    u32 ufirst_val = 0;
+};
+
+// Portable switch/output resolution.
+// Linux keeps its historical behaviour when the env vars are absent.
+inline const char* OutPath() {
+    static const char* p = std::getenv("AZAHAR_PICA_OUT");
+    if (p != nullptr && p[0] != '\0') {
+        return p;
+    }
+    return "/home/ms/mof_trace/pica.txt";
+}
+
+inline const char* TriggerPath() {
+    static const char* p = std::getenv("AZAHAR_PICA_TRIGGER");
+    if (p != nullptr && p[0] != '\0') {
+        return p;
+    }
+    return "/tmp/azahar_pica_trace";
+}
+
+inline bool Triggered() {
+    std::FILE* probe = std::fopen(TriggerPath(), "rb");
+    if (probe != nullptr) {
+        std::fclose(probe);
+        return true;
+    }
+    return false;
+}
+
+inline State& S() {
+    static State s;
+    return s;
+}
+
+inline bool On() {
+    State& s = S();
+    if (s.enabled < 0) {
+        if (Triggered()) {
+            s.f = std::fopen(OutPath(), "wb");
+        }
+        s.enabled = (s.f != nullptr) ? 1 : 0;
+    }
+    return s.enabled == 1;
+}
+
+inline void ResetUniforms() {
+    State& s = S();
+    s.ucount = 0;
+    s.ufirst = 0;
+    s.ulast = 0;
+    s.uxor = 0;
+    s.ufirst_val = 0;
+}
+
+inline void RecheckSwitch() {
+    State& s = S();
+    if (Triggered()) {
+        if (!s.f) {
+            s.f = std::fopen(OutPath(), "ab");
+            if (s.f) {
+                static char io_buf[1 << 20];
+                std::setvbuf(s.f, io_buf, _IOFBF, sizeof(io_buf));
+            }
+        }
+        s.enabled = (s.f != nullptr) ? 1 : 0;
+    } else {
+        if (s.f) {
+            std::fclose(s.f);
+            s.f = nullptr;
+        }
+        s.enabled = 0;
+    }
+}
+
+inline void BeginFrame(u32 api) {
+    RecheckSwitch();
+    if (!On()) {
+        return;
+    }
+    State& s = S();
+    ++s.frame;
+    s.draw_idx = 0;
+    ResetUniforms();
+    std::fprintf(s.f, "F %llu %u %lld\n", static_cast<unsigned long long>(s.frame), api,
+                 static_cast<long long>(
+                     std::chrono::duration_cast<std::chrono::milliseconds>(
+                         std::chrono::system_clock::now().time_since_epoch())
+                         .count()));
+}
+
+inline u32 Djb2(const void* data, std::size_t len) {
+    const auto* p = static_cast<const u8*>(data);
+    u32 h = 5381u;
+    for (std::size_t i = 0; i < len; ++i) {
+        h = ((h << 5) + h) ^ static_cast<u32>(p[i]);
+    }
+    return h;
+}
+
+// Full per-draw dumps are ~700x larger than the census, so they stay opt-in.
+inline bool FullDump() {
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* e = std::getenv("AZAHAR_PICA_FULL");
+        enabled = (e != nullptr && e[0] == '1') ? 1 : 0;
+    }
+    return enabled == 1;
+}
+
+// 0 = dump every draw, otherwise only draws with this exact vertex count.
+inline u32 FocusNverts() {
+    static u32 focus = 0xFFFFFFFFu;
+    if (focus == 0xFFFFFFFFu) {
+        const char* e = std::getenv("AZAHAR_PICA_FOCUS_NVERTS");
+        focus = (e != nullptr && e[0] != '\0') ? static_cast<u32>(std::strtoul(e, nullptr, 10)) : 0u;
+    }
+    return focus;
+}
+
+inline bool WantDraw(u32 nverts) {
+    if (!FullDump()) {
+        return false;
+    }
+    const u32 focus = FocusNverts();
+    return focus == 0u || nverts == focus;
+}
+
+// One cheap line per draw, covering the WHOLE frame. hashU changes when the VS uniform file
+// changed relative to the previous draw of this index; hashV does the same for vertex slot 0.
+// A skinned mesh fed from a static FCRAM buffer shows hashV constant + hashU moving; a CPU
+// skinned mesh shows hashV moving.
+// X <frame> <draw> <base> <nverts> <ucount> <use_gs> <path> <hashU> <hashV>
+inline void NoteCensus(u32 addr0, u32 addr1, u32 nverts, u32 use_gs, u32 path,
+                       const void* uni, std::size_t uni_bytes, const void* vtx,
+                       std::size_t vtx_bytes, u64 hash_prog, u64 hash_swz) {
+    if (!On()) {
+        return;
+    }
+    State& s = S();
+    std::fprintf(s.f, "X %llu %llu %08X %08X %u %llu %u %u %08X %08X %016llX %016llX\n",
+                 static_cast<unsigned long long>(s.frame),
+                 static_cast<unsigned long long>(s.draw_idx), addr0, addr1, nverts,
+                 static_cast<unsigned long long>(s.ucount), use_gs, path, Djb2(uni, uni_bytes),
+                 Djb2(vtx, vtx_bytes), static_cast<unsigned long long>(hash_prog),
+                 static_cast<unsigned long long>(hash_swz));
+}
+
+inline void NoteCmdList(u32 addr, u32 size) {
+    if (!On()) {
+        return;
+    }
+    State& s = S();
+    std::fprintf(s.f, "L %llu %08X %u\n", static_cast<unsigned long long>(s.frame), addr, size);
+}
+
+inline void NoteUniformWrite(u32 first, u32 count, const u32* values) {
+    if (!On()) {
+        return;
+    }
+    State& s = S();
+    if (s.ucount == 0) {
+        s.ufirst = first;
+        s.ufirst_val = (count > 0) ? values[0] : 0;
+    }
+    s.ulast = static_cast<u64>(first) + count;
+    for (u32 i = 0; i < count; ++i) {
+        s.uxor ^= values[i];
+    }
+    s.ucount += count;
+}
+
+// Uniforms are a persistent register file, so almost every vec4 repeats unchanged from
+// frame to frame. Emitting only the deltas keeps the trace ~20x smaller and avoids
+// slowing the emulator down to the point where the frame rate itself perturbs the data.
+inline void NoteUniformState(u32 nverts, const std::array<float, 384>& v) {
+    if (!On()) {
+        return;
+    }
+    if (nverts < 16) {
+        return;
+    }
+    State& s = S();
+    if (s.draw_idx >= 1024) {
+        return;
+    }
+    static u32 prev_uni[1024][96][4];
+    static bool prev_valid[1024] = {};
+    const u32 d = static_cast<u32>(s.draw_idx);
+    bool any = false;
+    char line[8192];
+    int n = std::snprintf(line, sizeof(line), "U %llu %llu %u", 
+                          static_cast<unsigned long long>(s.frame),
+                          static_cast<unsigned long long>(s.draw_idx), nverts);
+    for (u32 i = 0; i < 96; ++i) {
+        u32 b[4];
+        std::memcpy(b, &v[i * 4], sizeof(b));
+        if (b[0] == 0 && b[1] == 0 && b[2] == 0 && b[3] == 0) {
+            continue;
+        }
+        if (prev_valid[d] && prev_uni[d][i][0] == b[0] && prev_uni[d][i][1] == b[1] &&
+            prev_uni[d][i][2] == b[2] && prev_uni[d][i][3] == b[3]) {
+            continue;
+        }
+        prev_uni[d][i][0] = b[0];
+        prev_uni[d][i][1] = b[1];
+        prev_uni[d][i][2] = b[2];
+        prev_uni[d][i][3] = b[3];
+        any = true;
+        if (n < static_cast<int>(sizeof(line)) - 40) {
+            n += std::snprintf(line + n, sizeof(line) - n, " %u=%08X,%08X,%08X,%08X", i, b[0],
+                               b[1], b[2], b[3]);
+        }
+    }
+    prev_valid[d] = true;
+    if (!any) {
+        return;
+    }
+    line[n] = '\n';
+    std::fwrite(line, 1, static_cast<std::size_t>(n) + 1, s.f);
+}
+
+// Vertex attribute layout for the current draw (dumped once per draw on the SW path):
+// C <frame> <draw> <format>:<elements>:<stride> x12
+inline void NoteAttrConfig(const std::array<u32, 36>& cfg) {
+    if (!On()) {
+        return;
+    }
+    State& s = S();
+    if (s.draw_idx >= 1024) {
+        return;
+    }
+    const u32 d = static_cast<u32>(s.draw_idx);
+    static u32 prev_cfg[1024][36];
+    static bool prev_cfg_valid[1024] = {};
+    bool changed = !prev_cfg_valid[d];
+    for (u32 i = 0; i < 36; ++i) {
+        if (prev_cfg[d][i] != cfg[i]) {
+            changed = true;
+            prev_cfg[d][i] = cfg[i];
+        }
+    }
+    prev_cfg_valid[d] = true;
+    if (!changed) {
+        return;
+    }
+    std::fprintf(s.f, "C %llu %llu", static_cast<unsigned long long>(s.frame),
+                 static_cast<unsigned long long>(s.draw_idx));
+    for (u32 i = 0; i < 12; ++i) {
+        std::fprintf(s.f, " %u:%u:%u", cfg[i * 3 + 0], cfg[i * 3 + 1], cfg[i * 3 + 2]);
+    }
+    std::fputc('\n', s.f);
+}
+
+// Decoded attributes of one vertex (SW path only; the HW path never runs VertexLoader).
+// V <frame> <draw> <vertex> <nattr> <i>=<b,b,b,b> ...
+inline void NoteVertex(u32 vertex, const std::array<float, 64>& v, u32 nattr) {
+    if (!On()) {
+        return;
+    }
+    State& s = S();
+    if (s.draw_idx >= 1024) {
+        return;
+    }
+    const u32 d = static_cast<u32>(s.draw_idx);
+    static u32 prev_vtx[1024][16][4];
+    static bool prev_vtx_valid[1024] = {};
+    bool any = false;
+    char line[2048];
+    int n = std::snprintf(line, sizeof(line), "V %llu %llu %u %u",
+                          static_cast<unsigned long long>(s.frame),
+                          static_cast<unsigned long long>(s.draw_idx), vertex, nattr);
+    for (u32 i = 0; i < nattr; ++i) {
+        u32 b[4];
+        std::memcpy(b, &v[i * 4], sizeof(b));
+        if (b[0] == 0 && b[1] == 0 && b[2] == 0 && b[3] == 0) {
+            continue;
+        }
+        if (prev_vtx_valid[d] && prev_vtx[d][i][0] == b[0] && prev_vtx[d][i][1] == b[1] &&
+            prev_vtx[d][i][2] == b[2] && prev_vtx[d][i][3] == b[3]) {
+            continue;
+        }
+        prev_vtx[d][i][0] = b[0];
+        prev_vtx[d][i][1] = b[1];
+        prev_vtx[d][i][2] = b[2];
+        prev_vtx[d][i][3] = b[3];
+        any = true;
+        if (n < static_cast<int>(sizeof(line)) - 48) {
+            n += std::snprintf(line + n, sizeof(line) - n, " %u=%08X,%08X,%08X,%08X", i, b[0],
+                               b[1], b[2], b[3]);
+        }
+    }
+    prev_vtx_valid[d] = true;
+    if (!any) {
+        return;
+    }
+    line[n] = '\n';
+    std::fwrite(line, 1, static_cast<std::size_t>(n) + 1, s.f);
+}
+
+inline void NoteDraw(u32 base, u32 nverts, u32 use_gs, u32 path) {
+    if (!On()) {
+        return;
+    }
+    State& s = S();
+    std::fprintf(s.f, "D %llu %llu %08X %u %llu %llu %llu %08X %08X %u p=%u\n",
+                 static_cast<unsigned long long>(s.frame),
+                 static_cast<unsigned long long>(s.draw_idx), base, nverts,
+                 static_cast<unsigned long long>(s.ucount),
+                 static_cast<unsigned long long>(s.ufirst),
+                 static_cast<unsigned long long>(s.ulast), s.uxor, s.ufirst_val, use_gs, path);
+    ++s.draw_idx;
+    ResetUniforms();
+}
+
+} // namespace MoFTrace
