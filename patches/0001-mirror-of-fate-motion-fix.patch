+// Diagnostic channel for the pacing loop: AZAHAR_PACE_LOG=<file> writes one row per presented
+// frame. This exists to answer "why does only one stretch of the map slide?" with numbers instead
+// of guesses -- it shows the exact frame where the limiter stops sleeping and starts catching up.
+struct PaceLog {
+    FILE* f = nullptr;
+    bool tried = false;
+
+    void write(long long frame, long long sys_us, long long wall_us, long long err_before,
+               long long err_after, long long slept_us) {
+        if (!tried) {
+            tried = true;
+            const char* env = std::getenv("AZAHAR_PACE_LOG");
+            if (env != nullptr && env[0] != '\0') {
+                const char* path = (std::strcmp(env, "1") == 0) ? "azahar_pace.csv" : env;
+                f = std::fopen(path, "wb");
+                if (f != nullptr) {
+                    std::fputs("frame,sys_us,wall_us,err_before_us,err_after_us,slept_us\n", f);
+                }
+            }
+        }
+        if (f == nullptr) {
+            return;
+        }
+        std::fprintf(f, "%lld,%lld,%lld,%lld,%lld,%lld\n", frame, sys_us, wall_us, err_before,
+                     err_after, slept_us);
+        std::fflush(f);
+    }
+};
+PaceLog g_pace_log;
+
+// Rolling pacing statistics, emitted to logcat every kReportFrames presented frames.
+//
+// This exists because on Android there is no way to set AZAHAR_PACE_LOG (no env), so the CSV
+// channel is unavailable on a handheld. A one-line summary every 240 frames (4 s at 60 Hz) is
+// cheap enough to leave in and tells us the one number that matters:
+//   sys_avg / 16714us = guest frame loops per presented frame.
+// 1.0 means the guest and the display are locked; 2.0 means the character advances two animation
+// steps per displayed frame, which is what "foot sliding" looks like.
+struct PaceStats {
+    static constexpr u64 kReportFrames = 240;
+    static constexpr long long kFrameUs = 16714;  // one 3DS frame at 100% speed
+
+    u64 frames = 0;
+    long long sys_sum = 0;
+    long long wall_sum = 0;
+    long long slept_sum = 0;
+    long long sys_max = 0;
+    u64 over_1_2 = 0;  // >= 1.2 guest frames in one present
+    u64 over_1_8 = 0;  // >= 1.8, i.e. essentially two loops
+    u64 hist_2k[16] = {};  // sys_us bucketed per 2000us, saturating at 30ms
+
+    void add(long long sys_us, long long wall_us, long long slept_us) {
+        ++frames;
+        sys_sum += sys_us;
+        wall_sum += wall_us;
+        slept_sum += slept_us;
+        if (sys_us > sys_max) {
+            sys_max = sys_us;
+        }
+        if (sys_us * 10 >= kFrameUs * 12) {
+            ++over_1_2;
+        }
+        if (sys_us * 10 >= kFrameUs * 18) {
+            ++over_1_8;
+        }
+        const u64 bucket = static_cast<u64>(sys_us < 0 ? 0 : sys_us / 2000);
+        ++hist_2k[bucket < 15 ? bucket : 15];
+    }
+
+    long long percentile_us(u64 pct) const {
+        const u64 target = frames * pct / 100;
+        u64 acc = 0;
+        for (u64 i = 0; i < 16; ++i) {
+            acc += hist_2k[i];
+            if (acc >= target) {
+                return static_cast<long long>(i) * 2000 + 1000;
+            }
+        }
+        return sys_max;
+    }
+
+    void report_if_due() {
+        if (frames < kReportFrames) {
+            return;
+        }
+        const double sys_avg = double(sys_sum) / frames;
+        const double wall_avg = double(wall_sum) / frames;
+        LOG_INFO(Core,
+                 "PACESTATS frames={} sys_avg={:.0f} sys_p50={} sys_p90={} sys_max={} "
+                 "loops_per_frame={:.3f} wall_avg={:.0f} slept_avg={:.0f} ge12={} ge18={}",
+                 frames, sys_avg, percentile_us(50), percentile_us(90), sys_max,
+                 sys_avg / double(kFrameUs), wall_avg, double(slept_sum) / frames, over_1_2,
+                 over_1_8);
+        frames = 0;
+        sys_sum = 0;
+        wall_sum = 0;
+        slept_sum = 0;
+        sys_max = 0;
+        over_1_2 = 0;
+        over_1_8 = 0;
+        for (auto& slot : hist_2k) {
+            slot = 0;
+        }
+    }
+};
+PaceStats g_pace_stats;
