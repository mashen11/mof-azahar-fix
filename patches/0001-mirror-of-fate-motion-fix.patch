diff --git a/src/core/render_census.h b/src/core/render_census.h
new file mode 100644
index 0000000..8d1af2f
--- /dev/null
+++ b/src/core/render_census.h
@@ -0,0 +1,113 @@
+// Copyright 2023-2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+// TEMPORARY INSTRUMENTATION -- renders-per-frame census.
+//
+// The sliding / folding-waist defect is "the guest rendered the whole scene more than once
+// inside one presented frame".  The authoritative metric is
+//
+//     renders_per_frame = character_draws / render_targets_per_scene / presented_frames
+//
+// and real hardware answers exactly 1.000.  Keeping this as plain counters plus one log
+// line per kReportFrames presented frames makes the metric readable on Android, where the
+// PICA file trace cannot be used at all.
+#pragma once
+
+#include "common/common_types.h"
+#include "common/logging/log.h"
+
+namespace RenderCensus {
+
+// The character mesh of the title under investigation, measured with the PICA trace.
+// Every other draw count is irrelevant here, so the check is exact rather than a range.
+constexpr u32 kCharacterVerts = 1704;
+// Where the 19-bone x 3-row skeleton palette sits in the VS float uniform file, and how many
+// vec4 slots it occupies.  Taken from the full-state uniform dump of this title.
+constexpr u32 kPaletteFirstSlot = 25;
+constexpr u32 kPaletteSlots = 57;
+// How many render targets one whole-scene render draws the character into:
+// the main colour target plus two shadow cascades.
+constexpr u32 kRenderTargetsPerScene = 3;
+// A submit that is a whole-scene command list rather than a small state-only batch.
+constexpr u32 kBigSubmitBytes = 100000;
+// One report roughly every four seconds at 60 Hz.
+constexpr u64 kReportFrames = 240;
+
+struct Counters {
+    u64 frames = 0;
+    u64 draws = 0;
+    u64 chars = 0;
+    u64 subs = 0;
+    // Distinct skeleton palettes seen for the character inside the current presented frame.
+    // This is the direct symptom metric and does not depend on knowing how many render
+    // targets one scene render touches: one pose per frame is correct, two is the defect.
+    u32 poses = 0;
+    u64 pose_sum = 0;
+    u32 pose_hash[8] = {};
+};
+
+inline Counters& C() {
+    static Counters c;
+    return c;
+}
+
+inline u32 Djb2(const void* data, std::size_t len) {
+    const auto* p = static_cast<const u8*>(data);
+    u32 h = 5381u;
+    for (std::size_t i = 0; i < len; ++i) {
+        h = ((h << 5) + h) ^ static_cast<u32>(p[i]);
+    }
+    return h;
+}
+
+// `pal` points at the 19-bone x 3-row skeleton palette living in the VS float uniforms.
+// Draws of the same pose hash identically, so the number of distinct hashes in one presented
+// frame is the number of different body poses that ended up on screen together.
+inline void OnDraw(u32 nverts, const void* pal, std::size_t pal_bytes) {
+    Counters& c = C();
+    ++c.draws;
+    if (nverts != kCharacterVerts) {
+        return;
+    }
+    ++c.chars;
+    const u32 h = Djb2(pal, pal_bytes);
+    for (u32 i = 0; i < c.poses; ++i) {
+        if (c.pose_hash[i] == h) {
+            return;
+        }
+    }
+    if (c.poses < 8) {
+        c.pose_hash[c.poses++] = h;
+    }
+}
+
+inline void OnSubmit(u32 bytes) {
+    if (bytes >= kBigSubmitBytes) {
+        ++C().subs;
+    }
+}
+
+// Called once per presented frame.  Reporting on the same cadence as PACESTATS keeps the
+// two lines vertically aligned in a log, which makes "timing says 1 guest frame but two
+// poses were on screen" visible at a glance.
+inline void OnPresentedFrame() {
+    Counters& c = C();
+    ++c.frames;
+    c.pose_sum += c.poses;
+    c.poses = 0;
+    if (c.frames < kReportFrames) {
+        return;
+    }
+    const double frames = static_cast<double>(c.frames);
+    const double renders = static_cast<double>(c.chars) /
+                           static_cast<double>(kRenderTargetsPerScene) / frames;
+    LOG_INFO(Core,
+             "RENDERSTATS frames={} draws_avg={:.1f} char_avg={:.2f} subs_avg={:.2f} "
+             "poses_per_frame={:.3f} renders_per_frame={:.3f}",
+             c.frames, static_cast<double>(c.draws) / frames,
+             static_cast<double>(c.chars) / frames, static_cast<double>(c.subs) / frames,
+             static_cast<double>(c.pose_sum) / frames, renders);
+    c = Counters{};
+}
+
+} // namespace RenderCensus
